# NVIDIA NIM API Configuration
# Get your API key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models configuration
NVIDIA_TUTOR_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_GRADING_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embed-v1
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1

# Application configuration
NEXT_PUBLIC_APP_NAME="MPC Studio"
NEXT_PUBLIC_APP_URL=http://localhost:3000
